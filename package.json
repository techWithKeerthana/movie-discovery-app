{
  "name": "trackzio",
  "private": true,
  "version": "1.0.0",
  "main": "index.ts",
  "workspaces": [
    "shared",
    "backend"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:mobile": "expo start",
    "dev:backend": "npm run dev -w backend",
    "mock:tmdb": "node tools/mock-tmdb.mjs",
    "test": "npm test -w backend",
    "test:mobile": "jest",
    "test:all": "npm test && npm run test:mobile",
    "typecheck": "npm run typecheck -w backend && tsc --noEmit",
    "verify:tmdb": "npm run verify:tmdb -w backend --"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@tanstack/react-query": "^5.103.2",
    "@trackzio/shared": "*",
    "expo": "~57.0.24",
    "expo-crypto": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@trackzio/.*|@tanstack/.*))"
    ],
    "testTimeout": 20000
  }
}
